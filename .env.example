# Recognize AI Backend — Environment Configuration
# Copy this file to .env and adjust values as needed.

# Directory where ONNX models are stored (default: ./models)
# RECOGNIZE_MODELS_DIR=./models

# Server host and port (default: 127.0.0.1:8000)
# RECOGNIZE_HOST=127.0.0.1
# RECOGNIZE_PORT=8000

# Maximum upload file size in bytes (default: 20 MB = 20971520)
# RECOGNIZE_MAX_UPLOAD_SIZE=20971520

# ONNX Runtime execution providers, comma-separated.
# Options: CUDAExecutionProvider, TensorrtExecutionProvider, CPUExecutionProvider
# For GPU: CUDAExecutionProvider,CPUExecutionProvider
# For CPU only: CPUExecutionProvider
# RECOGNIZE_ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

# --- Track 1 & 4 Optimizations ---
# Use quantized INT8 models (.quant.onnx) first if available (default: True)
# RECOGNIZE_USE_QUANTIZED=True

# Limit core utilization by limiting intra-op and inter-op threads (default: CPU default)
# RECOGNIZE_INTRA_OP_THREADS=4
# RECOGNIZE_INTER_OP_THREADS=1

# ONNX Runtime execution mode: sequential or parallel (default: sequential)
# RECOGNIZE_EXECUTION_MODE=sequential

# --- Nextcloud ExApp Settings (auto-injected by AppAPI) ---
# APP_ID=recognize_ai
# APP_SECRET=<auto-generated>
# APP_PORT=8000
# NEXTCLOUD_URL=https://your-nextcloud.example.com

# --- File Scanner Settings ---
# RECOGNIZE_SCANNER_ENABLED=false
# RECOGNIZE_SCANNER_BATCH_SIZE=50
# RECOGNIZE_SCANNER_INTERVAL=300
